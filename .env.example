# AI
ANTHROPIC_API_KEY=

# Redis (SAME Upstash instance already used for Fluentsmith — copy the values
# from that Vercel project's env vars, don't create a new database)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Paddle (new product/prices under the existing Paddle seller account)
NEXT_PUBLIC_PADDLE_ENV=production
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=
NEXT_PUBLIC_PADDLE_PRICE_ID=
NEXT_PUBLIC_PADDLE_LIFETIME_PRICE_ID=
PADDLE_WEBHOOK_SECRET=
PADDLE_API_KEY=

# Optional dedicated signing key. Falls back to PADDLE_WEBHOOK_SECRET.
PRO_SESSION_SECRET=

# Automatic Pro access emails. Use a sending-only Resend key and a verified domain.
RESEND_API_KEY=
RECOVERY_EMAIL_FROM=
